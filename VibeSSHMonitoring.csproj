<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>VibeSSHMonitoring</AssemblyName>
    <RootNamespace>VibeSSHMonitoring</RootNamespace>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Custom entry point (Program.cs): Velopack must run before WPF -->
    <StartupObject>VibeSSHMonitoring.Program</StartupObject>
    <!-- Version: replaced by the tag's (v1.2.3) in the release workflow -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Vibe SSH Monitoring</Product>
    <AssemblyTitle>Vibe SSH Monitoring</AssemblyTitle>
    <Description>Monitor and update Debian / Ubuntu servers over SSH</Description>
    <Authors>Baba0bab</Authors>
    <Copyright>Copyright © 2026 Baba0bab — GPL-3.0-or-later</Copyright>
    <RepositoryUrl>https://github.com/Baba0bab/VibeSSHMonitoring</RepositoryUrl>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <!-- Precompiled code when publishing: faster startup (start with Windows) -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Single exe: native DLLs (WebView2Loader) are bundled and extracted when needed -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>en;fr;de;es</SatelliteResourceLanguages>
    <!-- Publishing: no package XML documentation, no separate .pdb (symbols embedded in the exe) -->
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- Self-contained build (.NET runtime included): compressed exe, ~2.5 times smaller -->
  <PropertyGroup Condition="'$(SelfContained)' == 'true'">
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- Reproducible builds on GitHub Actions (normalized source paths) -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <!-- Test project and repository files: not part of the application -->
  <ItemGroup>
    <Compile Remove="Tests\**;artifacts\**" />
    <None Remove="Tests\**;artifacts\**" />
    <Page Remove="Tests\**;artifacts\**" />
  </ItemGroup>

  <!-- Interface translations, read by Core/Loc.cs -->
  <ItemGroup>
    <EmbeddedResource Include="Localization\*.json" LogicalName="VibeSSHMonitoring.Localization.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Licenses shipped with the application -->
  <ItemGroup>
    <None Include="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Built-in terminal: xterm.js page loaded offline by WebView2 -->
  <ItemGroup>
    <None Include="Assets\terminal\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
