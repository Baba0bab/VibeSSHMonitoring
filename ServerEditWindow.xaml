<Window x:Class="VibeSSHMonitoring.ServerEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:VibeSSHMonitoring.UI"
        Title="{ui:Tr Editor.WindowTitle}"
        Width="700" Height="820" MinWidth="560" MinHeight="480"
        Background="{StaticResource BaseBrush}"
        FontFamily="{StaticResource TextFont}"
        FontSize="14"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="2,0,0,5"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="Field" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="28,20,28,24">
                <TextBlock x:Name="TitleText" Text="{ui:Tr Servers.Add}" Style="{StaticResource PageTitle}" FontSize="24"/>
                <TextBlock Text="{ui:Tr Editor.Subtitle}"
                           Style="{StaticResource PageSubtitle}" Margin="0,0,0,8"/>

                <!-- Connection -->
                <TextBlock Text="{ui:Tr Editor.Connection}" Style="{StaticResource SectionHeader}" Margin="2,12,0,10"/>
                <StackPanel Style="{StaticResource Field}">
                    <TextBlock Text="{ui:Tr Editor.DisplayName}" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="NameBox"/>
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Style="{StaticResource Field}">
                        <TextBlock Text="{ui:Tr Editor.Host}" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="HostBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Style="{StaticResource Field}">
                        <TextBlock Text="{ui:Tr Editor.Port}" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="PortBox" Text="22"/>
                    </StackPanel>
                </Grid>
                <StackPanel Style="{StaticResource Field}">
                    <TextBlock Text="{ui:Tr Editor.User}" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="UserBox" TextChanged="UserBox_TextChanged"/>
                </StackPanel>

                <!-- Authentication -->
                <TextBlock Text="{ui:Tr Editor.Authentication}" Style="{StaticResource SectionHeader}" Margin="2,8,0,10"/>
                <Border Style="{StaticResource SegmentedHost}" HorizontalAlignment="Left" Margin="0,0,0,14">
                    <StackPanel x:Name="AuthSegments" Orientation="Horizontal">
                        <RadioButton x:Name="AuthPasswordRadio" Style="{StaticResource Segment}" GroupName="Auth" Content="{ui:Tr Password.Label}"
                                     Checked="Auth_Checked"/>
                        <RadioButton x:Name="AuthKeyRadio" Style="{StaticResource Segment}" GroupName="Auth" Content="{ui:Tr Editor.SshKey}"
                                     Checked="Auth_Checked"/>
                    </StackPanel>
                </Border>
                <StackPanel x:Name="PasswordPanel">
                    <StackPanel Style="{StaticResource Field}">
                        <TextBlock Text="{ui:Tr Password.Label}" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="PasswordBox"/>
                    </StackPanel>
                    <Border Style="{StaticResource Card}" Background="{StaticResource InsetBrush}" Margin="0,0,0,14">
                        <DockPanel>
                            <Button x:Name="DeployKeyButton" DockPanel.Dock="Right" Tag="&#xE8D7;" Content="{ui:Tr Editor.DeployKey}"
                                    VerticalAlignment="Center" Margin="12,0,0,0" Click="DeployKey_Click"/>
                            <TextBlock Style="{StaticResource Icon}" DockPanel.Dock="Left" Text="&#xE946;" VerticalAlignment="Top"
                                       Margin="0,1,12,0" Foreground="{StaticResource AccentLightBrush}"/>
                            <TextBlock Style="{StaticResource Caption}" FontSize="13" TextWrapping="Wrap">
                                <Run Foreground="{StaticResource TextBrush}" Text="{ui:Tr Editor.TipTitle}"/>
                                <Run Text="{ui:Tr Editor.TipText}"/>
                            </TextBlock>
                        </DockPanel>
                    </Border>
                </StackPanel>
                <StackPanel x:Name="KeyPanel" Visibility="Collapsed">
                    <StackPanel Style="{StaticResource Field}">
                        <TextBlock Text="{ui:Tr Editor.PrivateKey}" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="KeyPathBox" FontFamily="{StaticResource MonoFont}" FontSize="13"/>
                            <Button Grid.Column="1" Content="{ui:Tr Editor.Browse}" Margin="8,0,0,0" Click="BrowseKey_Click"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Field}">
                        <TextBlock Text="{ui:Tr Editor.Passphrase}" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="PassphraseBox"/>
                    </StackPanel>
                </StackPanel>

                <!-- Elevation -->
                <TextBlock Text="{ui:Tr Editor.RootAccess}" Style="{StaticResource SectionHeader}" Margin="2,8,0,10"/>
                <Border x:Name="ElevationHost" Style="{StaticResource SegmentedHost}" HorizontalAlignment="Left" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ElevNoneRadio" Style="{StaticResource Segment}" GroupName="Elev" Content="{ui:Tr Editor.ElevationNone}"
                                     Checked="Elevation_Checked"/>
                        <RadioButton x:Name="ElevSudoRadio" Style="{StaticResource Segment}" GroupName="Elev" Content="sudo"
                                     Checked="Elevation_Checked"/>
                        <RadioButton x:Name="ElevSuRadio" Style="{StaticResource Segment}" GroupName="Elev" Content="su"
                                     Checked="Elevation_Checked"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="ElevationHint" Style="{StaticResource Caption}" FontSize="13" Margin="2,0,0,12"/>
                <StackPanel x:Name="SudoPanel" Visibility="Collapsed">
                    <ui:SettingCard Header="{ui:Tr Editor.SudoSame}" MinHeight="56"
                                    Description="{ui:Tr Editor.SudoSameDesc}">
                        <CheckBox x:Name="SudoSameSwitch" Style="{StaticResource Switch}" Checked="SudoSame_Changed"
                                  Unchecked="SudoSame_Changed"/>
                    </ui:SettingCard>
                    <StackPanel x:Name="SudoPasswordPanel" Style="{StaticResource Field}" Margin="0,8,0,14">
                        <TextBlock Text="{ui:Tr Editor.SudoPassword}" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="SudoPasswordBox"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="SuPanel" Style="{StaticResource Field}" Visibility="Collapsed">
                    <TextBlock Text="{ui:Tr Editor.RootPassword}" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="RootPasswordBox"/>
                </StackPanel>

                <!-- Groups -->
                <TextBlock Text="{ui:Tr Editor.Groups}" Style="{StaticResource SectionHeader}" Margin="2,8,0,10"/>
                <StackPanel Style="{StaticResource Field}">
                    <TextBlock Text="{ui:Tr Editor.GroupsHint}" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TagsBox"/>
                </StackPanel>

                <!-- Host key -->
                <StackPanel x:Name="HostKeySection">
                    <TextBlock Text="{ui:Tr Editor.HostKey}" Style="{StaticResource SectionHeader}" Margin="2,8,0,10"/>
                    <ui:SettingCard x:Name="HostKeyCard" Icon="&#xE8D7;" Header="—">
                        <Button Content="{ui:Tr Editor.ForgetKey}" Click="ForgetHostKey_Click"
                                ToolTip="{ui:Tr Editor.ForgetKeyTip}"/>
                    </ui:SettingCard>
                </StackPanel>

                <!-- Server-specific settings -->
                <TextBlock Text="{ui:Tr Editor.Overrides}" Style="{StaticResource SectionHeader}" Margin="2,16,0,2"/>
                <TextBlock Text="{ui:Tr Editor.OverridesDesc}"
                           Style="{StaticResource Caption}" FontSize="13" Margin="2,0,0,10"/>
                <StackPanel x:Name="OverridesPanel"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer: test and save -->
        <Border Grid.Row="1" Background="{StaticResource LayerBrush}" BorderBrush="{StaticResource StrokeBrush}"
                BorderThickness="0,1,0,0" Padding="28,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border x:Name="TestResult" Margin="0,0,0,12" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Control x:Name="TestSpinner" Style="{StaticResource Spinner}" Margin="0,0,10,0" VerticalAlignment="Top"/>
                        <TextBlock x:Name="TestIcon" Style="{StaticResource Icon}" Margin="0,1,10,0" VerticalAlignment="Top"
                                   Visibility="Collapsed"/>
                        <TextBlock x:Name="TestText" TextWrapping="Wrap" FontSize="13" MaxWidth="560"/>
                    </StackPanel>
                </Border>
                <DockPanel Grid.Row="1">
                    <Button x:Name="TestButton" DockPanel.Dock="Left" Tag="&#xE703;" Content="{ui:Tr Editor.Test}"
                            Click="Test_Click"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{ui:Tr Common.Cancel}" MinWidth="100" Margin="0,0,8,0" IsCancel="True"/>
                        <Button x:Name="SaveButton" Style="{StaticResource AccentButton}" Content="{ui:Tr Common.Save}" MinWidth="120"
                                IsDefault="True" Click="Save_Click"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
