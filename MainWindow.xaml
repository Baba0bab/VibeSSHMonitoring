<Window x:Class="VibeSSHMonitoring.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:VibeSSHMonitoring.UI"
        x:Name="Root"
        Title="Vibe SSH Monitoring"
        Width="1180" Height="780" MinWidth="640" MinHeight="520"
        Background="{StaticResource BaseBrush}"
        FontFamily="{StaticResource TextFont}"
        FontSize="14"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- ===== Card "⋯" menu ===== -->
        <ContextMenu x:Key="ServerMenu">
            <MenuItem Header="{ui:Tr Menu.Details}" Tag="&#xE946;" Click="MenuDetails_Click"/>
            <MenuItem Header="{ui:Tr Common.Refresh}" Tag="&#xE72C;" Click="MenuRefresh_Click"/>
            <MenuItem Header="{ui:Tr Menu.Edit}" Tag="&#xE70F;" Click="MenuEdit_Click"/>
            <MenuItem Header="{ui:Tr Menu.Duplicate}" Tag="&#xE8C8;" Click="MenuDuplicate_Click"/>
            <Separator/>
            <MenuItem Header="{ui:Tr Menu.Reboot}" Tag="&#xE7E8;" Click="MenuReboot_Click"/>
            <MenuItem Header="{ui:Tr Menu.Delete}" Tag="&#xE74D;" Foreground="{StaticResource DangerBrush}" Click="MenuDelete_Click"/>
        </ContextMenu>

        <!-- ===== Meter row ===== -->
        <Style x:Key="MeterLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="44"/>
        </Style>
        <Style x:Key="MeterValue" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
        </Style>

        <!-- ===== Server card ===== -->
        <DataTemplate x:Key="ServerCardTemplate">
            <Border x:Name="card" Style="{StaticResource Card}" Margin="0,0,12,12" Padding="16,14,16,12"
                    Cursor="Hand" MouseLeftButtonUp="Card_MouseLeftButtonUp">
                <StackPanel>
                    <!-- Header: selection, state, name, updates -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Style="{StaticResource SelectBox}" IsChecked="{Binding IsSelected}"
                                  VerticalAlignment="Top" Margin="0,2,12,0" ToolTip="{ui:Tr Card.SelectTip}"/>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Fill="{Binding StateBrush}" Margin="0,0,8,0"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Endpoint}" Style="{StaticResource Caption}" Margin="17,2,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding StateText}" FontSize="12" Foreground="{Binding StateBrush}"
                                       HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding LatencyText}" Style="{StaticResource Caption}" HorizontalAlignment="Right"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Groups -->
                    <ItemsControl ItemsSource="{Binding Tags}" Margin="30,8,0,0"
                                  Visibility="{Binding HasTags, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource NeutralBadge}" Margin="0,0,4,4">
                                    <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- System -->
                    <TextBlock Style="{StaticResource Caption}" Margin="30,8,0,0" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding ShowSystem, Converter={StaticResource BoolToVisibility}}">
                        <Run Text="{Binding OsText, Mode=OneWay}" Foreground="{StaticResource TextBrush}"/>
                        <Run Text="{ui:Tr Card.UpFor}"/>
                        <Run Text="{Binding UptimeText, Mode=OneWay}"/>
                    </TextBlock>

                    <!-- Resources -->
                    <Grid Margin="30,10,0,0" Visibility="{Binding ShowResources, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto" MinWidth="104"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="20"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{ui:Tr Meter.Cpu}" Style="{StaticResource MeterLabel}"/>
                        <ProgressBar Grid.Column="1" Style="{StaticResource Meter}" Value="{Binding CpuPercent, Mode=OneWay}"
                                     Foreground="{Binding CpuBrush}"/>
                        <TextBlock Grid.Column="2" Text="{Binding CpuText}" Style="{StaticResource MeterValue}"/>
                        <TextBlock Grid.Row="1" Text="{ui:Tr Meter.Ram}" Style="{StaticResource MeterLabel}"/>
                        <ProgressBar Grid.Row="1" Grid.Column="1" Style="{StaticResource Meter}" Value="{Binding MemPercent, Mode=OneWay}"
                                     Foreground="{Binding MemBrush}"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding MemText}" Style="{StaticResource MeterValue}"/>
                        <TextBlock Grid.Row="2" Text="{ui:Tr Meter.Disk}" Style="{StaticResource MeterLabel}"/>
                        <ProgressBar Grid.Row="2" Grid.Column="1" Style="{StaticResource Meter}" Value="{Binding DiskPercent, Mode=OneWay}"
                                     Foreground="{Binding DiskBrush}"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding DiskText}" Style="{StaticResource MeterValue}"/>
                    </Grid>

                    <!-- Updates -->
                    <WrapPanel Margin="30,10,0,0" Visibility="{Binding ShowUpdates, Converter={StaticResource BoolToVisibility}}">
                        <Border x:Name="updatesBadge" Style="{StaticResource NeutralBadge}" Margin="0,0,6,4" Padding="8,3"
                                Visibility="{Binding HasUpdateInfo, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="updatesIcon" Style="{StaticResource Icon}" Text="&#xE896;" FontSize="11"
                                           Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="updatesText" Text="{Binding UpdatesText}" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DangerBadge}" Margin="0,0,6,4" Padding="8,3"
                                Visibility="{Binding HasSecurityUpdates, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" FontSize="11" Margin="0,0,6,0"
                                           Foreground="#FFFF8F8A"/>
                                <TextBlock FontSize="12" Foreground="#FFFF8F8A">
                                    <Run Text="{Binding SecurityCount, Mode=OneWay}"/><Run Text="{ui:Tr Card.SecuritySuffix}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource WarningBadge}" Margin="0,0,6,4" Padding="8,3"
                                Visibility="{Binding RebootRequired, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7E8;" FontSize="11" Margin="0,0,6,0"
                                           Foreground="{StaticResource WarningBrush}"/>
                                <TextBlock Text="{ui:Tr Card.RebootRequired}" FontSize="12" Foreground="{StaticResource WarningBrush}"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <!-- Running operation / last reading -->
                    <StackPanel Orientation="Horizontal" Margin="30,6,0,0">
                        <Control Style="{StaticResource Spinner}" Width="12" Height="12" Margin="0,0,8,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Text="{Binding StatusLine}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="300" ToolTip="{Binding StateDetail}"/>
                    </StackPanel>

                    <!-- Actions: wrap when the card is narrow -->
                    <DockPanel Margin="0,12,0,0" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="32" Height="30" Content="&#xE712;"
                                FontSize="14" VerticalAlignment="Top" ToolTip="{ui:Tr Common.MoreActions}" Click="More_Click"/>
                        <WrapPanel>
                            <Button Style="{StaticResource SmallButton}" Tag="&#xE895;" Content="{ui:Tr Action.CheckUpdates}" Margin="0,0,6,6"
                                    IsEnabled="{Binding IsIdle}" Click="CheckUpdates_Click"
                                    ToolTip="{ui:Tr Action.CheckUpdatesTip}"/>
                            <Button Style="{StaticResource SmallAccentButton}" Tag="&#xE896;" Content="{ui:Tr Action.Update}"
                                    Margin="0,0,6,6" IsEnabled="{Binding IsIdle}" Click="Upgrade_Click"
                                    ToolTip="{ui:Tr Action.UpdateTip}"/>
                            <Button Style="{StaticResource SmallButton}" Tag="&#xE756;" Content="{ui:Tr Action.OpenSsh}"
                                    Margin="0,0,6,6" Click="OpenSsh_Click" ToolTip="{ui:Tr Action.OpenSshTip}"/>
                        </WrapPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter TargetName="card" Property="Background" Value="{StaticResource CardSelectedBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasUpdates}" Value="True">
                    <Setter TargetName="updatesBadge" Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
                    <Setter TargetName="updatesText" Property="Foreground" Value="{StaticResource AccentLightBrush}"/>
                    <Setter TargetName="updatesIcon" Property="Foreground" Value="{StaticResource AccentLightBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsUpToDate}" Value="True">
                    <Setter TargetName="updatesBadge" Property="Background" Value="#263DD68C"/>
                    <Setter TargetName="updatesText" Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                    <Setter TargetName="updatesIcon" Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                    <Setter TargetName="updatesIcon" Property="Text" Value="&#xE73E;"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== Info tile (details page) ===== -->
        <Style x:Key="InfoTile" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Side menu ================= -->
        <Border x:Name="Sidebar" Width="240" ClipToBounds="True">
            <DockPanel Margin="8,4,8,12">
                <Button x:Name="NavToggleButton" DockPanel.Dock="Top" Style="{StaticResource IconButton}"
                        Content="&#xE700;" HorizontalAlignment="Left" Margin="0,0,0,8"
                        ToolTip="{ui:Tr Nav.ToggleTip}" Click="NavToggleButton_Click"/>

                <!-- Footer: vault and summary, visible from every page -->
                <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="0,12,0,0"
                        BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0">
                    <Grid Width="224" Height="40" HorizontalAlignment="Left">
                        <Grid x:Name="SidebarVaultHost" Width="40" HorizontalAlignment="Left" Background="Transparent">
                            <Ellipse Width="30" Height="30" Fill="{StaticResource ControlBrush}"/>
                            <TextBlock x:Name="SidebarVaultIcon" Style="{StaticResource Icon}" Text="&#xE785;" FontSize="14"
                                       HorizontalAlignment="Center"/>
                            <Ellipse x:Name="SidebarStatusDot" Width="10" Height="10" Margin="20,20,0,0"
                                     Stroke="{StaticResource BaseBrush}" StrokeThickness="2" Fill="{StaticResource NeutralBrush}"/>
                        </Grid>
                        <StackPanel Margin="48,0,44,0" VerticalAlignment="Center">
                            <TextBlock x:Name="SidebarSummaryText" Text="{ui:Tr Summary.NoServer}" FontSize="13"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="SidebarVaultText" FontSize="12" Margin="0,1,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button x:Name="SidebarLockButton" Style="{StaticResource IconButton}" Width="36"
                                HorizontalAlignment="Right" Content="&#xE72E;" Click="SidebarLockButton_Click"/>
                    </Grid>
                </Border>

                <!-- Application update ready: visible from every page -->
                <Button x:Name="SidebarUpdateButton" DockPanel.Dock="Bottom" Style="{StaticResource SidebarAction}"
                        Tag="&#xE777;" Visibility="Collapsed" Click="AppUpdateInstall_Click"/>

                <RadioButton x:Name="NavSettings" DockPanel.Dock="Bottom" Style="{StaticResource NavItem}"
                             Tag="&#xE713;" Content="{ui:Tr Nav.Settings}" ToolTip="{ui:Tr Nav.SettingsTip}" Checked="Nav_Checked"/>

                <StackPanel>
                    <RadioButton x:Name="NavServers" Style="{StaticResource NavItem}"
                                 Tag="&#xE977;" Content="{ui:Tr Nav.Servers}" ToolTip="{ui:Tr Nav.ServersTip}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavTerminals" Style="{StaticResource NavItem}"
                                 Tag="&#xE756;" ToolTip="{ui:Tr Nav.TerminalsTip}" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{ui:Tr Nav.Terminals}" VerticalAlignment="Center"/>
                            <Border x:Name="TerminalCountBadge" Style="{StaticResource Badge}" Margin="10,0,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="TerminalCountText" FontSize="11" Foreground="{StaticResource AccentLightBrush}"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= Content ================= -->
        <Border Grid.Column="1" Background="{StaticResource LayerBrush}" BorderBrush="{StaticResource StrokeBrush}"
                BorderThickness="1,1,0,0" CornerRadius="8,0,0,0" ClipToBounds="True">
            <Grid>
                <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False" SizeChanged="PageScroller_SizeChanged">
                    <Grid x:Name="PageHost" MaxWidth="1240" Margin="36,28,36,36">

                        <!-- ========== Servers ========== -->
                        <StackPanel x:Name="ServersPage">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="{ui:Tr Nav.Servers}" Style="{StaticResource PageTitle}"/>
                                    <TextBlock x:Name="ServersSubtitle" Style="{StaticResource PageSubtitle}" Margin="0,0,0,20"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,0,0">
                                    <Button Tag="&#xE72C;" Content="{ui:Tr Servers.RefreshAll}" Margin="0,0,8,0" Click="RefreshAll_Click"
                                            ToolTip="{ui:Tr Servers.RefreshAllTip}"/>
                                    <Button Style="{StaticResource AccentButton}" Tag="&#xE710;" Content="{ui:Tr Servers.Add}"
                                            Click="AddServer_Click"/>
                                </StackPanel>
                            </Grid>

                            <!-- Search and group filters -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid VerticalAlignment="Top">
                                    <TextBox x:Name="SearchBox" Padding="34,0,10,0" TextChanged="SearchBox_TextChanged"/>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" Margin="12,0,0,0"
                                               Foreground="{StaticResource TextTertiaryBrush}" IsHitTestVisible="False"/>
                                    <TextBlock x:Name="SearchHint" Text="{ui:Tr Servers.SearchHint}" Margin="35,0,0,0"
                                               VerticalAlignment="Center" FontSize="13" IsHitTestVisible="False"
                                               Foreground="{StaticResource TextTertiaryBrush}"/>
                                </Grid>
                                <WrapPanel x:Name="TagFilters" Grid.Column="1" Margin="12,2,0,0"/>
                            </Grid>

                            <!-- Bulk action bar -->
                            <Border x:Name="SelectionBar" Style="{StaticResource Card}" Background="{StaticResource CardSelectedBrush}"
                                    BorderBrush="{StaticResource AccentBrush}" Padding="14,8" Margin="0,0,0,12" Visibility="Collapsed">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="SelectionText" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                        <Button Style="{StaticResource LinkButton}" Content="{ui:Tr Selection.All}" Margin="0,0,14,0"
                                                Click="SelectAll_Click"/>
                                        <Button Style="{StaticResource LinkButton}" Content="{ui:Tr Selection.None}" Click="ClearSelection_Click"/>
                                    </StackPanel>
                                    <WrapPanel HorizontalAlignment="Right">
                                        <Button Style="{StaticResource SmallButton}" Tag="&#xE72C;" Content="{ui:Tr Common.Refresh}" Margin="6,2,0,2"
                                                Click="BulkRefresh_Click"/>
                                        <Button Style="{StaticResource SmallButton}" Tag="&#xE895;" Content="{ui:Tr Action.CheckUpdates}" Margin="6,2,0,2"
                                                Click="BulkCheck_Click"/>
                                        <Button Style="{StaticResource SmallAccentButton}" Tag="&#xE896;" Content="{ui:Tr Action.Update}" Margin="6,2,0,2"
                                                Click="BulkUpgrade_Click"/>
                                        <Button Style="{StaticResource SmallButton}" Tag="&#xE7E8;" Content="{ui:Tr Action.Reboot}" Margin="6,2,0,2"
                                                Click="BulkReboot_Click"/>
                                    </WrapPanel>
                                </DockPanel>
                            </Border>

                            <!-- Empty state -->
                            <Border x:Name="EmptyState" Style="{StaticResource Card}" Padding="28,32" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE977;" FontSize="40" HorizontalAlignment="Center"
                                               Foreground="{StaticResource AccentLightBrush}" Margin="0,0,0,16"/>
                                    <TextBlock x:Name="EmptyTitle" Text="{ui:Tr Empty.NoServersTitle}" FontSize="18" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="EmptyText" Style="{StaticResource Caption}" FontSize="13" Margin="0,6,0,18"
                                               TextAlignment="Center" MaxWidth="460"
                                               Text="{ui:Tr Empty.NoServersText}"/>
                                    <Button x:Name="EmptyAddButton" Style="{StaticResource AccentButton}" Tag="&#xE710;"
                                            Content="{ui:Tr Servers.Add}" HorizontalAlignment="Center" Click="AddServer_Click"/>
                                </StackPanel>
                            </Border>

                            <ItemsControl x:Name="ServersList" ItemTemplate="{StaticResource ServerCardTemplate}" Margin="0,0,-12,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel ItemWidth="{Binding CardWidth, ElementName=Root}"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>

                        <!-- ========== Server details ========== -->
                        <StackPanel x:Name="DetailPage" Visibility="Collapsed">
                            <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,0,0,14"
                                    Click="BackToServers_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72B;" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="{ui:Tr Nav.Servers}"/>
                                </StackPanel>
                            </Button>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="12" Height="12" Fill="{Binding StateBrush}" Margin="0,4,12,0"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource PageTitle}"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource PageSubtitle}" Margin="24,0,0,20">
                                        <Run Text="{Binding Endpoint, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding AccessText, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding StateText, Mode=OneWay}" Foreground="{Binding StateBrush}"/>
                                        <Run Text="{Binding LatencyText, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12,4,0,0" MaxWidth="560">
                                    <Button Tag="&#xE72C;" Content="{ui:Tr Common.Refresh}" Margin="0,0,8,8" IsEnabled="{Binding IsIdle}"
                                            Click="DetailRefresh_Click"/>
                                    <Button Tag="&#xE895;" Content="{ui:Tr Action.CheckUpdates}" Margin="0,0,8,8" IsEnabled="{Binding IsIdle}"
                                            Click="CheckUpdates_Click"/>
                                    <Button Style="{StaticResource AccentButton}" Tag="&#xE896;" Content="{ui:Tr Action.Update}" Margin="0,0,8,8"
                                            IsEnabled="{Binding IsIdle}" Click="Upgrade_Click"/>
                                    <Button Tag="&#xE756;" Content="{ui:Tr Action.OpenSsh}" Margin="0,0,8,8" Click="OpenSsh_Click"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE712;" Margin="0,0,0,8"
                                            ToolTip="{ui:Tr Common.MoreActions}" Click="More_Click"/>
                                </WrapPanel>
                            </Grid>

                            <!-- Error banner -->
                            <Border x:Name="DetailProblem" Style="{StaticResource Card}" Background="#1FF2615C" BorderBrush="#55F2615C"
                                    Margin="0,0,0,16" Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisibility}}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE7BA;"
                                               Foreground="{StaticResource WarningBrush}" VerticalAlignment="Top" Margin="0,1,12,0"/>
                                    <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <Button x:Name="ApproveKeyButton" Content="{ui:Tr Detail.ApproveKey}" Click="ApproveKey_Click"
                                                Visibility="Collapsed"/>
                                        <Button x:Name="UnlockButton" Content="{ui:Tr Detail.Unlock}" Click="Unlock_Click" Visibility="Collapsed"/>
                                        <Button x:Name="FixButton" Content="{ui:Tr Detail.EditServer}" Click="MenuEdit_Click" Visibility="Collapsed"/>
                                    </WrapPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StateText}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding StateDetail}" Style="{StaticResource Caption}" FontSize="13" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <TextBlock Text="{ui:Tr Detail.System}" Style="{StaticResource SectionHeader}" Margin="2,0,0,8"/>
                            <UniformGrid x:Name="DetailInfoGrid" Columns="3" Margin="0,0,-8,0">
                                <Border Style="{StaticResource InfoTile}">
                                    <StackPanel>
                                        <TextBlock Text="{ui:Tr Detail.Os}" Style="{StaticResource Caption}"/>
                                        <TextBlock Text="{Binding OsText}" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InfoTile}">
                                    <StackPanel>
                                        <TextBlock Text="{ui:Tr Detail.Kernel}" Style="{StaticResource Caption}"/>
                                        <TextBlock Text="{Binding KernelText}" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InfoTile}">
                                    <StackPanel>
                                        <TextBlock Text="{ui:Tr Detail.Hostname}" Style="{StaticResource Caption}"/>
                                        <TextBlock Text="{Binding HostnameText}" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InfoTile}">
                                    <StackPanel>
                                        <TextBlock Text="{ui:Tr Detail.Uptime}" Style="{StaticResource Caption}"/>
                                        <TextBlock Text="{Binding UptimeText}" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InfoTile}">
                                    <StackPanel>
                                        <TextBlock Text="{ui:Tr Detail.Load}" Style="{StaticResource Caption}"/>
                                        <TextBlock Text="{Binding LoadText}" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InfoTile}">
                                    <StackPanel>
                                        <TextBlock Text="{ui:Tr Detail.Swap}" Style="{StaticResource Caption}"/>
                                        <TextBlock Text="{Binding SwapText}" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <TextBlock Text="{ui:Tr Detail.Resources}" Style="{StaticResource SectionHeader}" Margin="2,16,0,8"/>
                            <Border Style="{StaticResource Card}" Padding="18,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" MinWidth="140"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="28"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{ui:Tr Meter.Cpu}" VerticalAlignment="Center"/>
                                    <ProgressBar Grid.Column="1" Style="{StaticResource Meter}" Height="8"
                                                 Value="{Binding CpuPercent, Mode=OneWay}" Foreground="{Binding CpuBrush}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding CpuText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Text="{ui:Tr Detail.Memory}" VerticalAlignment="Center"/>
                                    <ProgressBar Grid.Row="1" Grid.Column="1" Style="{StaticResource Meter}" Height="8"
                                                 Value="{Binding MemPercent, Mode=OneWay}" Foreground="{Binding MemBrush}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding MemText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="2" Text="{ui:Tr Detail.DiskRoot}" VerticalAlignment="Center"/>
                                    <ProgressBar Grid.Row="2" Grid.Column="1" Style="{StaticResource Meter}" Height="8"
                                                 Value="{Binding DiskPercent, Mode=OneWay}" Foreground="{Binding DiskBrush}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding DiskText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Grid Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionHeader}" Margin="2,0,0,2">
                                        <Run Text="{ui:Tr Detail.AvailableUpdates}"/>
                                        <Run Text="{Binding UpdatesText, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Normal"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding LastCheckText}" Style="{StaticResource Caption}" Margin="2,0,0,8"/>
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource Card}" Padding="0">
                                <Grid>
                                    <TextBlock x:Name="NoPackagesText" Style="{StaticResource Caption}" FontSize="13" Margin="18,16"
                                               Text="{ui:Tr Detail.NoPackages}"/>
                                    <ItemsControl x:Name="PackagesList" ItemsSource="{Binding Packages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1" Padding="18,9">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*"/>
                                                            <ColumnDefinition Width="3*"/>
                                                            <ColumnDefinition Width="2*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            <Border x:Name="secBadge" Style="{StaticResource DangerBadge}" Margin="8,0,0,0" Visibility="Collapsed">
                                                                <TextBlock Text="{ui:Tr Detail.SecurityBadge}" FontSize="11" Foreground="#FFFF8F8A"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0">
                                                            <Run Text="{Binding OldVersion, Mode=OneWay}" Foreground="{StaticResource TextTertiaryBrush}"/>
                                                            <Run Text=" → " Foreground="{StaticResource TextTertiaryBrush}"/>
                                                            <Run Text="{Binding NewVersion, Mode=OneWay}" Foreground="{StaticResource TextBrush}"/>
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="2" Text="{Binding Suites}" Style="{StaticResource Caption}"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsSecurity}" Value="True">
                                                        <Setter TargetName="secBadge" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>

                            <Grid Margin="0,16,0,8">
                                <TextBlock Text="{ui:Tr Detail.Log}" Style="{StaticResource SectionHeader}" Margin="2,0,0,0"/>
                                <Button Style="{StaticResource SmallButton}" Tag="&#xE74D;" Content="{ui:Tr Detail.ClearLog}" HorizontalAlignment="Right"
                                        Click="ClearLog_Click"/>
                            </Grid>
                            <TextBox x:Name="LogBox" Style="{StaticResource ConsoleBox}" Height="340"
                                     Text="{Binding LogText, Mode=OneWay}"/>
                        </StackPanel>

                        <!-- ========== Settings ========== -->
                        <StackPanel x:Name="SettingsPage" Visibility="Collapsed" MaxWidth="900" HorizontalAlignment="Left">
                            <TextBlock Text="{ui:Tr Nav.Settings}" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="{ui:Tr Settings.Subtitle}"
                                       Style="{StaticResource PageSubtitle}"/>

                            <!-- General -->
                            <TextBlock Text="{ui:Tr Settings.General}" Style="{StaticResource SectionHeader}" Margin="2,0,0,8"/>
                            <ui:SettingCard x:Name="LanguageCard" Icon="&#xE774;" Header="{ui:Tr Settings.Language}"
                                            Description="{ui:Tr Settings.LanguageDesc}">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="LanguageRestartButton" Style="{StaticResource AccentButton}" Tag="&#xE72C;"
                                            Content="{ui:Tr Settings.LanguageRestart}" Margin="0,0,12,0" Visibility="Collapsed"
                                            Click="LanguageRestart_Click"/>
                                    <ComboBox x:Name="LanguageCombo" Width="230"/>
                                </StackPanel>
                            </ui:SettingCard>

                            <!-- Security -->
                            <TextBlock Text="{ui:Tr Settings.Security}" Style="{StaticResource SectionHeader}"/>
                            <ui:SettingCard x:Name="StorageCard" Icon="&#xE72E;" Header="{ui:Tr Settings.Storage}">
                                <Border Style="{StaticResource SegmentedHost}">
                                    <StackPanel x:Name="StorageSegments" Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" Tag="Dpapi" Content="{ui:Tr Settings.StorageDpapi}"/>
                                        <RadioButton Style="{StaticResource Segment}" Tag="MasterPassword" Content="{ui:Tr Settings.StorageMaster}"/>
                                        <RadioButton Style="{StaticResource Segment}" Tag="PlainText" Content="{ui:Tr Settings.StoragePlain}"/>
                                    </StackPanel>
                                </Border>
                            </ui:SettingCard>
                            <ui:SettingCard x:Name="MasterPasswordCard" Header="{ui:Tr Settings.StorageMaster}" Margin="38,0,0,4"
                                            Description="{ui:Tr Settings.MasterPasswordDesc}">
                                <Button Content="{ui:Tr Settings.Change}" Click="ChangeMasterPassword_Click"/>
                            </ui:SettingCard>
                            <ui:SettingCard x:Name="AutoLockCard" Header="{ui:Tr Settings.AutoLock}" Margin="38,0,0,4"
                                            Description="{ui:Tr Settings.AutoLockDesc}">
                                <Border Style="{StaticResource SegmentedHost}">
                                    <StackPanel x:Name="AutoLockSegments" Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" Tag="0" Content="{ui:Tr Common.Never}"/>
                                        <RadioButton Style="{StaticResource Segment}" Tag="15" Content="15 min"/>
                                        <RadioButton Style="{StaticResource Segment}" Tag="60" Content="1 h"/>
                                        <RadioButton Style="{StaticResource Segment}" Tag="240" Content="4 h"/>
                                    </StackPanel>
                                </Border>
                            </ui:SettingCard>

                            <!-- Terminal -->
                            <TextBlock Text="{ui:Tr Settings.Terminal}" Style="{StaticResource SectionHeader}"/>
                            <ui:SettingCard Icon="&#xE756;" Header="{ui:Tr Settings.TerminalFor}"
                                            Description="{ui:Tr Settings.TerminalDesc}">
                                <ComboBox x:Name="TerminalCombo" Width="230"/>
                            </ui:SettingCard>
                            <ui:SettingCard x:Name="CustomTerminalCard" Header="{ui:Tr Settings.CustomCommand}" Margin="38,0,0,4"
                                            Description="{ui:Tr Settings.CustomCommandDesc}">
                                <TextBox x:Name="CustomTerminalBox" Width="340" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                         LostFocus="CustomTerminalBox_LostFocus"/>
                            </ui:SettingCard>
                            <ui:SettingCard Icon="&#xE8C8;" Header="{ui:Tr Settings.CopyPassword}"
                                            Description="{ui:Tr Settings.CopyPasswordDesc}">
                                <CheckBox x:Name="CopyPasswordSwitch" Style="{StaticResource Switch}"/>
                            </ui:SettingCard>
                            <ui:SettingCard Icon="&#xE7EF;" Header="{ui:Tr Settings.RootShell}"
                                            Description="{ui:Tr Settings.RootShellDesc}">
                                <CheckBox x:Name="RootShellSwitch" Style="{StaticResource Switch}"/>
                            </ui:SettingCard>

                            <!-- Monitoring -->
                            <TextBlock Text="{ui:Tr Settings.Monitoring}" Style="{StaticResource SectionHeader}"/>
                            <ui:SettingCard Icon="&#xE701;" Header="{ui:Tr Settings.ShowOnline}"
                                            Description="{ui:Tr Settings.ShowOnlineDesc}">
                                <CheckBox x:Name="ShowOnlineSwitch" Style="{StaticResource Switch}"/>
                            </ui:SettingCard>
                            <ui:SettingCard Icon="&#xE9D9;" Header="{ui:Tr Detail.Resources}"
                                            Description="{ui:Tr Settings.ShowResourcesDesc}">
                                <CheckBox x:Name="ShowResourcesSwitch" Style="{StaticResource Switch}"/>
                            </ui:SettingCard>
                            <ui:SettingCard Icon="&#xE7F8;" Header="{ui:Tr Settings.ShowSystem}"
                                            Description="{ui:Tr Settings.ShowSystemDesc}">
                                <CheckBox x:Name="ShowSystemSwitch" Style="{StaticResource Switch}"/>
                            </ui:SettingCard>
                            <ui:SettingCard Icon="&#xE896;" Header="{ui:Tr Settings.ShowUpdates}"
                                            Description="{ui:Tr Settings.ShowUpdatesDesc}">
                                <CheckBox x:Name="ShowUpdatesSwitch" Style="{StaticResource Switch}"/>
                            </ui:SettingCard>
                            <ui:SettingCard Icon="&#xE72C;" Header="{ui:Tr Settings.RefreshInterval}">
                                <Border Style="{StaticResource SegmentedHost}">
                                    <StackPanel x:Name="RefreshSegments" Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" Tag="30" Content="30 s"/>
                                        <RadioButton Style="{StaticResource Segment}" Tag="60" Content="1 min"/>
                                        <RadioButton Style="{StaticResource Segment}" Tag="300" Content="5 min"/>
                                        <RadioButton Style="{StaticResource Segment}" Tag="900" Content="15 min"/>
                                    </StackPanel>
                                </Border>
                            </ui:SettingCard>
                            <ui:SettingCard Icon="&#xE895;" Header="{ui:Tr Settings.AutoCheck}"
                                            Description="{ui:Tr Settings.AutoCheckDesc}">
                                <Border Style="{StaticResource SegmentedHost}">
                                    <StackPanel x:Name="AutoCheckSegments" Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" Tag="0" Content="{ui:Tr Common.Never}"/>
                                        <RadioButton Style="{StaticResource Segment}" Tag="6" Content="6 h"/>
                                        <RadioButton Style="{StaticResource Segment}" Tag="12" Content="12 h"/>
                                        <RadioButton Style="{StaticResource Segment}" Tag="24" Content="24 h"/>
                                    </StackPanel>
                                </Border>
                            </ui:SettingCard>
                            <ui:SettingCard Icon="&#xEA8F;" Header="{ui:Tr Settings.NotifyUpdates}">
                                <CheckBox x:Name="NotifyUpdatesSwitch" Style="{StaticResource Switch}"/>
                            </ui:SettingCard>
                            <ui:SettingCard Icon="&#xE7BA;" Header="{ui:Tr Settings.NotifyOffline}">
                                <CheckBox x:Name="NotifyOfflineSwitch" Style="{StaticResource Switch}"/>
                            </ui:SettingCard>

                            <!-- Server updates -->
                            <TextBlock Text="{ui:Tr Settings.ServerUpdates}" Style="{StaticResource SectionHeader}"/>
                            <ui:SettingCard Icon="&#xE896;" Header="{ui:Tr Settings.UpgradeKind}"
                                            Description="{ui:Tr Settings.UpgradeKindDesc}">
                                <Border Style="{StaticResource SegmentedHost}">
                                    <StackPanel x:Name="UpgradeSegments" Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" Tag="Upgrade" Content="upgrade"/>
                                        <RadioButton Style="{StaticResource Segment}" Tag="FullUpgrade" Content="full-upgrade"/>
                                    </StackPanel>
                                </Border>
                            </ui:SettingCard>
                            <ui:SettingCard Icon="&#xE74D;" Header="{ui:Tr Settings.AutoRemove}"
                                            Description="{ui:Tr Settings.AutoRemoveDesc}">
                                <CheckBox x:Name="AutoRemoveSwitch" Style="{StaticResource Switch}"/>
                            </ui:SettingCard>

                            <!-- Application updates (GitHub Releases) -->
                            <TextBlock Text="{ui:Tr Settings.AppUpdates}" Style="{StaticResource SectionHeader}"/>
                            <ui:SettingCard x:Name="AppUpdateCard" Icon="&#xE777;" Header="Vibe SSH Monitoring">
                                <StackPanel Orientation="Horizontal">
                                    <Control x:Name="AppUpdateSpinner" Style="{StaticResource Spinner}" Margin="0,0,12,0"
                                             Visibility="Collapsed"/>
                                    <Button x:Name="AppUpdateCheckButton" Tag="&#xE72C;" Content="{ui:Tr AppUpdate.Check}"
                                            Click="AppUpdateCheck_Click"/>
                                    <Button x:Name="AppUpdateInstallButton" Style="{StaticResource AccentButton}" Tag="&#xE777;"
                                            Content="{ui:Tr AppUpdate.RestartInstall}" Visibility="Collapsed"
                                            Click="AppUpdateInstall_Click"/>
                                </StackPanel>
                            </ui:SettingCard>
                            <ui:SettingCard x:Name="AppUpdateAutoCheckCard" Icon="&#xE895;" Header="{ui:Tr AppUpdate.AutoCheck}"
                                            Description="{ui:Tr AppUpdate.AutoCheckDesc}">
                                <CheckBox x:Name="AppUpdateCheckSwitch" Style="{StaticResource Switch}"/>
                            </ui:SettingCard>
                            <ui:SettingCard x:Name="AppUpdateAutoInstallCard" Icon="&#xE896;" Header="{ui:Tr AppUpdate.AutoInstall}"
                                            Description="{ui:Tr AppUpdate.AutoInstallDesc}">
                                <CheckBox x:Name="AppUpdateAutoInstallSwitch" Style="{StaticResource Switch}"/>
                            </ui:SettingCard>
                            <ui:SettingCard x:Name="AppUpdatePrereleaseCard" Icon="&#xE9D9;" Header="{ui:Tr AppUpdate.Prerelease}"
                                            Description="{ui:Tr AppUpdate.PrereleaseDesc}">
                                <CheckBox x:Name="AppUpdatePrereleaseSwitch" Style="{StaticResource Switch}"/>
                            </ui:SettingCard>
                            <Border x:Name="AppUpdateNotesCard" Style="{StaticResource Card}" Background="{StaticResource InsetBrush}"
                                    Margin="0,0,0,4" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock x:Name="AppUpdateNotesTitle" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="AppUpdateNotesText" Style="{StaticResource Caption}" FontSize="13"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{ui:Tr Settings.Application}" Style="{StaticResource SectionHeader}"/>
                            <ui:SettingCard Icon="&#xE7E8;" Header="{ui:Tr Settings.StartWithWindows}">
                                <CheckBox x:Name="StartupSwitch" Style="{StaticResource Switch}"/>
                            </ui:SettingCard>
                            <ui:SettingCard Icon="&#xE73F;" Header="{ui:Tr Settings.StartMinimized}"
                                            Description="{ui:Tr Settings.StartMinimizedDesc}">
                                <CheckBox x:Name="MinimizedSwitch" Style="{StaticResource Switch}"/>
                            </ui:SettingCard>
                            <ui:SettingCard Icon="&#xE711;" Header="{ui:Tr Settings.CloseToTray}"
                                            Description="{ui:Tr Settings.CloseToTrayDesc}">
                                <CheckBox x:Name="CloseToTraySwitch" Style="{StaticResource Switch}"/>
                            </ui:SettingCard>

                            <TextBlock Text="{ui:Tr Settings.About}" Style="{StaticResource SectionHeader}"/>
                            <ui:SettingCard x:Name="AboutCard" Icon="&#xE946;" Header="Vibe SSH Monitoring">
                                <Button Tag="&#xE8B7;" Content="{ui:Tr Settings.ConfigFolder}" Click="OpenConfigFolder_Click"/>
                            </ui:SettingCard>
                            <ui:SettingCard Icon="&#xE765;" Header="{ui:Tr Settings.Shortcuts}"
                                            Description="{ui:Tr Settings.ShortcutsDesc}"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- ========== Terminals (outside the scroller: the terminal fills the whole area) ========== -->
                <Grid x:Name="TerminalsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1" Padding="10,8,10,8">
                        <DockPanel>
                            <Button x:Name="NewTerminalButton" DockPanel.Dock="Right" Style="{StaticResource SmallButton}"
                                    Tag="&#xE710;" Content="{ui:Tr Terminals.New}" Click="NewTerminal_Click" ToolTip="{ui:Tr Terminals.NewTip}"/>
                            <ListBox x:Name="TerminalTabs" Style="{StaticResource TabStrip}" SelectionChanged="TerminalTabs_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Fill="{Binding StateBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Title}" FontSize="13" VerticalAlignment="Center" MaxWidth="200"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Button Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="10"
                                                    Content="&#xE711;" Margin="6,0,0,0" ToolTip="{ui:Tr Common.Close}" Click="CloseTerminal_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                    <Grid x:Name="TerminalHost" Grid.Row="1"/>
                    <StackPanel x:Name="NoTerminalState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE756;" FontSize="40" HorizontalAlignment="Center"
                                   Foreground="{StaticResource AccentLightBrush}" Margin="0,0,0,16"/>
                        <TextBlock Text="{ui:Tr Terminals.EmptyTitle}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Style="{StaticResource Caption}" FontSize="13" Margin="0,6,0,18" TextAlignment="Center"
                                   Text="{ui:Tr Terminals.EmptyText}"/>
                        <Button Style="{StaticResource AccentButton}" Tag="&#xE710;" Content="{ui:Tr Terminals.NewTerminal}"
                                HorizontalAlignment="Center" Click="NewTerminal_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Short-lived message -->
                <Border x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"
                        Background="#FF26262F" BorderBrush="#FF34343F" BorderThickness="1" CornerRadius="8"
                        Padding="16,10" Opacity="0" IsHitTestVisible="False" MaxWidth="560">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="{StaticResource SuccessBrush}"
                                   Margin="0,0,10,0"/>
                        <TextBlock x:Name="ToastText" TextWrapping="Wrap" FontSize="13"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
